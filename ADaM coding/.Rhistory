knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(readxl)
library(openxlsx)
library(lubridate)
adsl_src <- read.xlsx("ADaM-like/ADSL.xlsx")
mh_src <- read.xlsx("SDTM/MH_MEDICALHISTORY.xlsx")
adsl_ada <-
adsl_src %>%
select(STUDYID, SUBJID, USUBJID, TRTP, TRTPN) %>%
mutate(
STUDYID = as.character(STUDYID),
SUBJID  = as.character(SUBJID),
USUBJID = as.character(USUBJID),
TRTP    = as.character(TRTP),
TRTPN   = as.integer(TRTPN)
)
impute_iso_date <- function(dtc) {
case_when(
is.na(dtc) | dtc == "" ~ NA_character_,
nchar(dtc) == 4 ~ paste0(dtc, "-01-01"),
nchar(dtc) == 7 ~ paste0(dtc, "-01"),
TRUE ~ dtc
)
}
mh_ada <-
mh_src %>%
filter(MHCAT == "Medical History") %>%
select(
STUDYID,
SUBJID,
MHSEQ,
MHCAT,
MHTERM,
MHDECOD,
MHBODSYS,
MHSTDTC,
MHENDTC,
MHENRTPT
) %>%
mutate(
STUDYID = as.character(STUDYID),
SUBJID = as.character(SUBJID),
MHSEQ = as.integer(MHSEQ),
MHCAT = as.character(MHCAT),
MHTERM = as.character(MHTERM),
MHDECOD = as.character(MHDECOD),
MHBODSYS = as.character(MHBODSYS),
MHSTDTC = as.character(MHSTDTC),
MHENDTC = as.character(MHENDTC),
MHENRTPT = as.character(MHENRTPT)
) %>%
filter(!is.na(MHTERM)) %>%
mutate(
USUBJID = paste(STUDYID, SUBJID, sep = "-"),
mhstdtc_imp = impute_iso_date(MHSTDTC),
ASTDT = if_else(
is.na(mhstdtc_imp),
"",
format(as.Date(mhstdtc_imp), "%d.%m.%Y")
),
ASTDTF = case_when(
is.na(MHSTDTC) | MHSTDTC == "" ~ "Y",
nchar(MHSTDTC) == 4 ~ "M",
nchar(MHSTDTC) == 7 ~ "D",
TRUE ~ ""
),
mhendtc_imp = if_else(
MHENRTPT == "ONGOING",
NA_character_,
impute_iso_date(MHENDTC)
),
AENDT = case_when(
MHENRTPT == "ONGOING" ~ "",
is.na(mhendtc_imp)    ~ "",
TRUE ~ format(as.Date(mhendtc_imp), "%d.%m.%Y")
),
AENDTF = case_when(
is.na(MHENDTC) | MHENDTC == "" ~ "Y",
nchar(MHENDTC) == 4 ~ "M",
nchar(MHENDTC) == 7 ~ "D",
TRUE ~ ""
),
MHENRF = if_else(MHENRTPT == "ONGOING", "ONGOING", "")
)
admh_tmp <-
adsl_ada %>%
left_join(
mh_ada,
by = c("STUDYID", "USUBJID")
) %>%
filter(!is.na(MHTERM)) %>%
select(
STUDYID,
USUBJID,
TRTP,
TRTPN,
MHSEQ,
MHCAT,
MHTERM,
MHDECOD,
MHBODSYS,
MHSTDTC,
ASTDT,
ASTDTF,
MHENDTC,
AENDT,
AENDTF,
MHENRTPT,
MHENRF
)
ADMH <-
admh_tmp %>%
mutate(
across(
.cols = -c(TRTPN, MHSEQ),
.fns = as.character
)
)
str(ADMH)
write.xlsx(ADMH, "ADaM-like/ADMH.xlsx")
