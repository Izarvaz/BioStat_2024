table_categorical <- cleaned_data %>%
group_by(Группа) %>%
summarise(
across(
where(~ is.factor(.) || is.character(.)),   # только категориальные
~list(table(., useNA = "no")),              # создаём таблицу частот
.names = "{.col}"
)
) %>%
pivot_longer(
cols = -Группа,
names_to = "Переменная",
values_to = "Частоты"
) %>%
unnest_longer(Частоты) %>%
rename(Значение = Частоты_id, Абс_количество = Частоты) %>%
group_by(Группа, Переменная) %>%
mutate(
Отн_количество = round(Абс_количество / sum(Абс_количество) * 100, 1)
) %>%
ungroup()
