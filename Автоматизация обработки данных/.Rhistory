"01-704-1008","01-704-1120","01-704-1218"
),
VSORRES / 2.54,
VSORRES
),
VSORRESU = if_else(
VSTEST == "Height" & USUBJID %in% c(
"01-704-1332","01-713-1141","01-704-1025",
"01-713-1106","01-717-1344","01-705-1059",
"01-704-1008","01-704-1120","01-704-1218"
),
"IN",
VSORRESU
)
)
